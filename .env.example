# =============================================================================
# StarOps SaaS — Environment Configuration Template
# Salin file ini menjadi `.env.local` lalu isi nilai proyek Supabase Anda.
# =============================================================================

# Publik (aman di-inline ke bundle client Next.js)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-Only (JANGAN pernah diawali NEXT_PUBLIC_ atau dikirim ke client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Kunci enkripsi AES-256 (pgcrypto) untuk Subscription Vault (minimal 32 karakter acak)
VAULT_ENCRYPTION_KEY="change-this-to-a-strong-random-32-char-secret-key"

# Token Bearer untuk otorisasi endpoint Vercel Cron (/api/cron/*)
CRON_SECRET="change-this-to-a-strong-cron-secret"
